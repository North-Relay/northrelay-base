# syntax=docker/dockerfile:1
# Locked application dependencies and scanned tooling; see SECURITY.md.
FROM golang:1.27@sha256:512690a5660563b57d37ecc31129e7f136e831db2aed24a1dbeb8ad7380dc0fa AS mc-build
WORKDIR /src
RUN curl -fsSL https://codeload.github.com/minio/mc/tar.gz/77f82e18b5401a65958f1619df6ebb994634bd88 -o /tmp/mc.tar.gz \
    && echo '167415edd21bc29f5360943dac64272aa5cda0a39f3070b15cfeca671c43d975  /tmp/mc.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/mc.tar.gz --strip-components=1 -C /src
COPY tools/mc/go.mod tools/mc/go.sum ./
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath -ldflags="-s -w -X github.com/minio/mc/cmd.Version=2026-09-09T00:00:00Z -X github.com/minio/mc/cmd.CommitID=77f82e18b5401a65958f1619df6ebb994634bd88" -o /out/mc .

FROM node:22-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends openssl wget curl ca-certificates postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --prefer-offline --no-audit --no-fund --legacy-peer-deps \
    && npm cache clean --force
# Runtime jobs use Node directly; package managers are build-time tooling.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY tools/mc/LICENSE /usr/share/licenses/minio-mc/LICENSE
RUN groupadd --system --gid 1001 nodejs && useradd --system --create-home --uid 1001 --gid nodejs nextjs
ENV PORT=3000 HOSTNAME="0.0.0.0"
USER nextjs

ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
LABEL org.opencontainers.image.source="https://github.com/North-Relay/northrelay-base"
LABEL org.opencontainers.image.base.name="docker.io/library/node:22-trixie-slim"
LABEL org.opencontainers.image.base.digest="sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284"
LABEL minio.mc.source.revision="77f82e18b5401a65958f1619df6ebb994634bd88"
