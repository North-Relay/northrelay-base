# syntax=docker/dockerfile:1
# Locked application dependencies and scanned tooling; see SECURITY.md.
FROM golang:1.27@sha256:512690a5660563b57d37ecc31129e7f136e831db2aed24a1dbeb8ad7380dc0fa AS mc-build
WORKDIR /src
RUN curl -fsSL https://codeload.github.com/minio/mc/tar.gz/77f82e18b5401a65958f1619df6ebb994634bd88 -o /tmp/mc.tar.gz \
    && echo '167415edd21bc29f5360943dac64272aa5cda0a39f3070b15cfeca671c43d975  /tmp/mc.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/mc.tar.gz --strip-components=1 -C /src
COPY tools/mc/go.mod tools/mc/go.sum ./
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath -ldflags="-s -w -X github.com/minio/mc/cmd.Version=2026-09-09T00:00:00Z -X github.com/minio/mc/cmd.CommitID=77f82e18b5401a65958f1619df6ebb994634bd88" -o /out/mc . \
    && go list -mod=readonly -deps . > /out/mc-dependencies.txt \
    && ! grep -q '^golang.org/x/crypto/openpgp' /out/mc-dependencies.txt

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
RUN apk upgrade --no-cache && apk add --no-cache openssl curl ca-certificates postgresql-client
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --prefer-offline --no-audit --no-fund --legacy-peer-deps \
    && npm cache clean --force
# Runtime jobs use Node directly; package managers are build-time tooling.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY tools/mc/LICENSE /usr/share/licenses/minio-mc/LICENSE
COPY --from=mc-build /out/mc-dependencies.txt /usr/share/minio-mc/compiled-packages.txt
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs
ENV PORT=3000 HOSTNAME="0.0.0.0"
USER nextjs

ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
LABEL org.opencontainers.image.source="https://github.com/North-Relay/northrelay-base"
LABEL org.opencontainers.image.base.name="docker.io/library/node:22-alpine"
LABEL org.opencontainers.image.base.digest="sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402"
LABEL minio.mc.source.revision="77f82e18b5401a65958f1619df6ebb994634bd88"
